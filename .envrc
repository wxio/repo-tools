use flake

# The git aliases live in .gitshared, which git reads only when this
# clone's .git/config includes it. A relative include.path is read from
# the directory of the file that holds it, .git/, hence the `../`.
if ! git config --local --get-all include.path 2>/dev/null | grep -qxF `pwd`/.gitshared; then
  git config --local --add include.path `pwd`/.gitshared
fi
watch_file `pwd`/.gitshared
